# ──────────────────────────────────────────────────────────────────
# Sevu API Server — Environment Variables
# Copy this file to .env and fill in the values
# ──────────────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/sevu

# ─── JWT Authentication ───────────────────────────────────────────
# Secret key for signing JWT tokens.
# Use a long random string in production (e.g. openssl rand -hex 32)
JWT_SECRET=change-this-to-a-long-random-secret

# ─── OTP Mode ─────────────────────────────────────────────────────
# Controlled via USE_REAL_OTP in src/config/otp.ts
#
# TEST MODE  (USE_REAL_OTP = false):
#   - OTP is printed to the server console
#   - No SMS is sent
#   - No MSG91 credentials needed
#
# PRODUCTION MODE (USE_REAL_OTP = true):
#   - OTP is sent via MSG91 SMS API
#   - Requires MSG91_API_KEY and MSG91_TEMPLATE_ID below

# ─── MSG91 SMS API (only needed in PRODUCTION MODE) ───────────────
# Get these from https://msg91.com/
MSG91_API_KEY=your_msg91_api_key_here
MSG91_TEMPLATE_ID=your_msg91_template_id_here

# ─── Node Environment ─────────────────────────────────────────────
NODE_ENV=development
